@page
@model PennyPincher.WebApp.Pages.EnableBanking.IndexModel
@{
    ViewData["Title"] = "Linked Banks";
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Linked Banks</h4>
    <span class="text-muted small">@Model.Accounts.Count linked account(s)</span>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h6 class="card-title">Link a bank</h6>

        <form method="get" class="d-flex gap-2 align-items-end mb-3">
            <div>
                <label class="form-label small text-muted mb-1">Country</label>
                <select asp-for="Country" asp-items="Model.CountryItems"
                        class="form-select form-select-sm" style="width: 12rem;"
                        onchange="this.form.submit()"></select>
            </div>
            <span class="text-muted small ms-2 mb-2">@Model.Banks.Count bank(s) available</span>
        </form>

        <form method="post" asp-page-handler="Link" class="d-flex gap-2 align-items-end">
            <div>
                <label class="form-label small text-muted mb-1">Bank</label>
                <select name="aspspName" class="form-select form-select-sm" id="aspspSelect">
                    @foreach (var b in Model.Banks)
                    {
                        <option value="@b.Name" data-country="@b.Country">@b.Name (@b.Country)@(b.Beta ? " · beta" : "")@(b.PsuTypes.Contains("personal") ? "" : " · no personal")</option>
                    }
                </select>
            </div>
            <input type="hidden" name="aspspCountry" id="aspspCountry" value="@(Model.Banks.FirstOrDefault()?.Country ?? Model.Country)" />
            <button type="submit" class="btn btn-primary btn-sm" disabled="@(Model.Banks.Count == 0)">Link</button>
        </form>
    </div>
</div>

@if (Model.Accounts.Count > 0)
{
    <div class="table-responsive mb-4">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>IBAN / ID</th>
                    <th>Product</th>
                    <th>Currency</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Accounts)
                {
                    <tr>
                        <td>@(a.Name ?? "—")</td>
                        <td><code class="small">@(a.Iban ?? "—")</code></td>
                        <td>@(a.Product ?? "—")</td>
                        <td>@(a.Currency ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p class="text-muted">No banks linked yet. Link one above to get started.</p>
}

@section Scripts {
    <script>
        const aspspSelect = document.getElementById('aspspSelect');
        const aspspCountry = document.getElementById('aspspCountry');
        if (aspspSelect && aspspCountry) {
            const syncCountry = () => {
                const opt = aspspSelect.options[aspspSelect.selectedIndex];
                if (opt) aspspCountry.value = opt.getAttribute('data-country');
            };
            aspspSelect.addEventListener('change', syncCountry);
            syncCountry();
        }
    </script>
}
