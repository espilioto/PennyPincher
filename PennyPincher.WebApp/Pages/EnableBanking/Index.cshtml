@page
@model PennyPincher.WebApp.Pages.EnableBanking.IndexModel
@{
    ViewData["Title"] = "Linked Banks";
}

@Html.AntiForgeryToken()

<h4 class="mb-3">Linked Banks</h4>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (Model.SessionStatus?.IsLinked == true)
{
    var validUntil = Model.SessionStatus.ValidUntil;
    int? daysLeft = validUntil.HasValue
        ? (int)Math.Ceiling((validUntil.Value - DateTimeOffset.UtcNow).TotalDays)
        : null;
    var expired = daysLeft is <= 0;
    var expiringSoon = daysLeft is > 0 and <= 14;
    var alertClass = expired ? "alert-danger" : expiringSoon ? "alert-warning" : "alert-success";
    var btnClass = expired ? "btn-danger" : expiringSoon ? "btn-warning" : "btn-outline-secondary";

    <div class="alert @alertClass d-flex justify-content-between align-items-center">
        <div>
            @if (expired)
            {
                <strong>Connection expired.</strong>
                <span>Re-link to reconnect and refresh your accounts.</span>
            }
            else
            {
                <strong>Connected</strong>
                <span>· @Model.SessionStatus.AccountCount account(s)</span>
                @if (validUntil.HasValue)
                {
                    <span>· valid until @validUntil.Value.ToString("d MMM yyyy")</span>
                    <span class="opacity-75">(@daysLeft day@(daysLeft == 1 ? "" : "s") left)</span>
                }
            }
        </div>
        <a class="btn btn-sm @btnClass" href="#link-bank">@(expired ? "Re-link now" : "Re-link")</a>
    </div>
}

<div class="card mb-4" id="link-bank">
    <div class="card-body">
        <h6 class="card-title">Link a bank</h6>

        <form method="get" class="d-flex gap-2 align-items-end mb-3">
            <div>
                <label class="form-label small text-muted mb-1">Country</label>
                <select asp-for="Country" asp-items="Model.CountryItems"
                        class="form-select form-select-sm" style="width: 12rem;"
                        onchange="this.form.submit()"></select>
            </div>
            <span class="text-muted small ms-2 mb-2">@Model.Banks.Count bank(s) available</span>
        </form>

        <form method="post" asp-page-handler="Link" class="d-flex gap-2 align-items-end">
            <div>
                <label class="form-label small text-muted mb-1">Bank</label>
                <select name="aspspName" class="form-select form-select-sm" id="aspspSelect">
                    @foreach (var b in Model.Banks)
                    {
                        <option value="@b.Name" data-country="@b.Country">@b.Name (@b.Country)@(b.Beta ? " · beta" : "")@(b.PsuTypes.Contains("personal") ? "" : " · no personal")</option>
                    }
                </select>
            </div>
            <input type="hidden" name="aspspCountry" id="aspspCountry" value="@(Model.Banks.FirstOrDefault()?.Country ?? Model.Country)" />
            <button type="submit" class="btn btn-primary btn-sm" disabled="@(Model.Banks.Count == 0)">Link</button>
        </form>
    </div>
</div>

@if (Model.Accounts.Count > 0)
{
    <div class="table-responsive mb-4">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>IBAN / ID</th>
                    <th>Product</th>
                    <th>Currency</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Accounts)
                {
                    <tr>
                        <td>@(a.Name ?? "—")</td>
                        <td><code class="small">@(a.Iban ?? "—")</code></td>
                        <td>@(a.Product ?? "—")</td>
                        <td>@(a.Currency ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p class="text-muted">No banks linked yet. Link one above to get started.</p>
}

@section Scripts {
    <script>
        const aspspSelect = document.getElementById('aspspSelect');
        const aspspCountry = document.getElementById('aspspCountry');
        if (aspspSelect && aspspCountry) {
            const syncCountry = () => {
                const opt = aspspSelect.options[aspspSelect.selectedIndex];
                if (opt) aspspCountry.value = opt.getAttribute('data-country');
            };
            aspspSelect.addEventListener('change', syncCountry);
            syncCountry();
        }
    </script>
}
